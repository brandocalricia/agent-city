+const KEYLESS_NO_KEY_PROVIDERS = new Set(["duckduckgo-web"]);
+
+/** A keyed provider with no stored key must not be routable or shown as an error. */
+export function unkeyedApikeyConnection(data: {
+  provider?: unknown;
+  authType?: unknown;
+  apiKey?: unknown;
+  accessToken?: unknown;
+}): boolean {
+  const provider = typeof data.provider === "string" ? data.provider : "";
+  if (KEYLESS_NO_KEY_PROVIDERS.has(provider) || isCompatibleProviderConnectionId(provider)) {
+    return false;
+  }
+  const auth = typeof data.authType === "string" ? data.authType : "";
+  if (auth !== "apikey") return false;
+  const apiKey = typeof data.apiKey === "string" ? data.apiKey.trim() : "";
+  const access = typeof data.accessToken === "string" ? data.accessToken.trim() : "";
+  return apiKey.length === 0 && access.length === 0;
+}
